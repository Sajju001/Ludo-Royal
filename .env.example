# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Email OTP Delivery via SMTP (e.g., Maileroo: smtp.maileroo.com, Port 587/465/2525)
SMTP_HOST="smtp.maileroo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Ludo Royale <noreply@your-domain.example>"

# HMAC secret for stateless OTP tokens (required on Vercel serverless)
OTP_SECRET=""

# Optional Resend API alternative
RESEND_API_KEY=""
